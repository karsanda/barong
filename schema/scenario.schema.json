{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "minLength": 1
    },
    "viewport": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "waitUntil": {
      "type": "string",
      "enum": [
        "load",
        "domcontentloaded",
        "networkidle"
      ]
    },
    "captures": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "selector": {
            "description": "Capture the first element matching this CSS selector",
            "type": "string",
            "minLength": 1
          },
          "clip": {
            "description": "Capture a fixed region of the page",
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0
              },
              "y": {
                "type": "number",
                "minimum": 0
              },
              "width": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "x",
              "y",
              "width",
              "height"
            ],
            "additionalProperties": false
          },
          "fullPage": {
            "description": "Capture the full scrollable page",
            "type": "boolean"
          },
          "actions": {
            "default": [],
            "description": "Interactions to run before capturing",
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "click": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "click"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "hover": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "hover"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "fill": {
                      "type": "string",
                      "minLength": 1
                    },
                    "value": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "fill",
                    "value"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "press": {
                      "type": "string",
                      "minLength": 1
                    },
                    "selector": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "press"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "scroll": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "scroll"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "waitFor": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "waitFor"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "wait": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "wait"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "hide": {
            "default": [],
            "description": "Elements to make invisible",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "mask": {
            "default": [],
            "description": "Elements to cover with a solid box",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "label"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "label",
    "url",
    "captures"
  ],
  "additionalProperties": false
}
