{
  "$schema": "https://unpkg.com/barong@1/schema/scenario.schema.json",
  "label": "Playwright docs",
  "url": "https://playwright.dev/docs/intro",
  "captures": [
    {
      "label": "Search dialog",
      "actions": [{ "click": ".DocSearch-Button" }, { "waitFor": ".DocSearch-Modal" }],
      "selector": ".DocSearch-Modal"
    },
    {
      "label": "Navbar hover",
      "actions": [{ "hover": ".navbar__item.dropdown" }, { "wait": 200 }],
      "selector": ".navbar",
      "mask": [".navbar__search"]
    }
  ]
}
